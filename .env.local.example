# Resend — envoi emails transactionnels formulaire qualifiant
# Demander une clé sur https://resend.com puis vérifier le domaine groupevalorimmo.fr
# avant de switcher RESEND_FROM_EMAIL vers contact@groupevalorimmo.fr.
RESEND_API_KEY=re_xxxxxxxxxxxx

# Expéditeur. Fallback dev : "Valor Immo <onboarding@resend.dev>" tant que
# groupevalorimmo.fr n'est pas vérifié côté Resend (cf. sprint 2 brief, voie
# d'exécution Resend).
RESEND_FROM_EMAIL=Valor Immo <onboarding@resend.dev>

# Destinataire des leads internes (boîte de l'agence).
RESEND_TO_EMAIL=contact1valorimmo@gmail.com

# URL canonique du site (sans / final).
NEXT_PUBLIC_SITE_URL=https://groupevalorimmo.fr

# Apimo — flux annonces immobilières (https://api.apimo.pro)
# Identifiants Basic Auth : provider ID + token fournis par Apimo.
APIMO_PROVIDER=xxxx
APIMO_TOKEN=xxxxxxxxxxxx
