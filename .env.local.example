# Resend — envoi emails transactionnels formulaire qualifiant
# Demander une clé sur https://resend.com puis vérifier le domaine valor-immo.com
# avant de switcher RESEND_FROM_EMAIL vers contact@valor-immo.com.
RESEND_API_KEY=re_xxxxxxxxxxxx

# Expéditeur. Fallback dev : "Valor Immo <onboarding@resend.dev>" tant que
# valor-immo.com n'est pas vérifié côté Resend (cf. sprint 2 brief, voie
# d'exécution Resend).
RESEND_FROM_EMAIL=Valor Immo <onboarding@resend.dev>

# Destinataire des leads internes (boîte de l'agence).
RESEND_TO_EMAIL=contact1valorimmo@gmail.com

# URL canonique du site (sans / final).
NEXT_PUBLIC_SITE_URL=https://valor-immo.com
